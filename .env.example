# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
#   cp .env.example .env

# --- PostgreSQL -------------------------------------------------------------
# tools/run-backend.ps1 and tools/run-backend.sh read these three values;
# plain `./mvnw spring-boot:run` does not, so export them in your shell or IDE.
POSTGRES_URL=jdbc:postgresql://YOUR_HOST.neon.tech/neondb?sslmode=require
POSTGRES_USER=YOUR_USER
POSTGRES_PASSWORD=YOUR_PASSWORD

# --- Backend ----------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
FRONTEND_ORIGIN=http://localhost:3000

# Base64-encoded HMAC-SHA256 key, at least 32 bytes once decoded. Generate one:
#   openssl rand -base64 48
JWT_SECRET=

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=Price Radar

# --- ReefAPI (tools/reefapi/fetch.mjs) --------------------------------------
# Key for the one-off marketplace data fetch. Never commit the real value.
REEFAPI_API_KEY=

# --- SonarQube --------------------------------------------------------------
# Project analysis token, created in the SonarQube UI.
SONAR_TOKEN=
SONAR_HOST_URL=
