
# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=price_radar
POSTGRES_USER=price_radar
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Elasticsearch ----------------------------------------------------------
ELASTICSEARCH_PORT=9200

# --- Kafka ------------------------------------------------------------------
KAFKA_PORT=9092

# --- Backend ----------------------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
FRONTEND_ORIGIN=http://localhost:3000

JWT_SECRET=

# --- Frontend ---------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_SITE_NAME=Price Radar

# --- ReefAPI (tools/reefapi/fetch.mjs) --------------------------------------
# Key for the one-off marketplace data fetch. Never commit the real value.
REEFAPI_API_KEY=

# --- SonarQube (docker compose --profile quality) ---------------------------
SONARQUBE_PORT=9000
SONAR_DB_PASSWORD=change-me
# Project analysis token, created in the SonarQube UI.
SONAR_TOKEN=
SONAR_HOST_URL=http://localhost:9000
