# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
#   cp .env.example .env

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=price_radar
POSTGRES_USER=price_radar
POSTGRES_PASSWORD=change-me
# If a PostgreSQL service is already installed on this machine it will own 5432
# and the backend will silently connect to it instead of the container. Either
# stop that service or pick a free port here (e.g. 5433) and point the backend
# at it with POSTGRES_URL below. See "Port 5432 conflict" in the README.
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Elasticsearch ----------------------------------------------------------
ELASTICSEARCH_PORT=9200

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=price_radar
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Backend ----------------------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
FRONTEND_ORIGIN=http://localhost:3000

# Only needed if POSTGRES_PORT above is not 5432. NOTE: `./mvnw spring-boot:run`
# does not read this file — export it in your shell or set it in your IDE's run
# configuration. Docker Compose builds this URL itself for the backend service.
# POSTGRES_URL=jdbc:postgresql://localhost:5433/price_radar

# Base64-encoded HMAC-SHA256 key, at least 32 bytes once decoded. Generate one:
#   openssl rand -base64 48
JWT_SECRET=

# --- Frontend ---------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_SITE_NAME=Price Radar

# --- SonarQube (docker compose --profile quality) ---------------------------
SONARQUBE_PORT=9000
SONAR_DB_PASSWORD=change-me
# Project analysis token, created in the SonarQube UI.
SONAR_TOKEN=
SONAR_HOST_URL=http://localhost:9000
