# --- Secrets & local config -------------------------------------------------
.env
.env.local
.env.*.local
!.env.example

# --- Java / Maven -----------------------------------------------------------
target/
*.class
*.ctxt
.mtj.tmp/
!**/src/main/**/target/
!**/src/test/**/target/

# Packaged artifacts (the Maven wrapper here is script-only, no jar)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
!**/.mvn/wrapper/*.jar

# JVM crash logs
hs_err_pid*
replay_pid*

# --- Node / Next.js ---------------------------------------------------------
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.turbo/

# --- Logs -------------------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*

# --- Tooling ----------------------------------------------------------------
.scannerwork/
.sonar/
coverage/

